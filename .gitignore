# .gitignore
# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
*.sqlite3
*.db
*.log

# Virtual environments
venv/
.env
.env.local
.env.*.local
!.env.example
!.env.test

# Package Files #
.streamlit/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --- OS junk ---
.DS_Store
Thumbs.db

# --- VS Code ---
.vscode/
.history/

# --- Testing ---
.pytest_cache/
coverage/
htmlcov/
.cache/

# --- Misc ---
*.bak
*.tmp
*.swp
*.swo
*.log
